<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- clear discards any feed a machine-wide or user-wide config might add, so a
       restore pulls the same packages from the same place everywhere. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
