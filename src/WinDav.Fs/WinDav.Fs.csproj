<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WinFsp host. First project that is allowed to be Windows-only. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <!-- Not for code of ours. The LibraryImport generator always emits its marshalling stub
         as unsafe, even for a signature that has nothing to marshal, so a project that calls
         into Windows at all has to allow it (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The read path is an implementation detail of the mount and none of it is public. The
         tests reach the gate and the budget the way the file system reaches them. -->
    <InternalsVisibleTo Include="WinDav.Fs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="winfsp.net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDav.Abstractions\WinDav.Abstractions.csproj" />
    <ProjectReference Include="..\WinDav.Core\WinDav.Core.csproj" />
  </ItemGroup>

</Project>
