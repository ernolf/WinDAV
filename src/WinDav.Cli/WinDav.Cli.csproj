<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The command users type. Derived so the executable is renamed with the product. -->
    <AssemblyName>$(ProductSlug)</AssemblyName>
    <RootNamespace>WinDav.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nothing here is meant to be called from elsewhere, so nothing here is public. The
         tests reach the argument handling the same way the program does. -->
    <InternalsVisibleTo Include="WinDav.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDav.Core\WinDav.Core.csproj" />
    <ProjectReference Include="..\WinDav.Fs\WinDav.Fs.csproj" />
    <ProjectReference Include="..\WinDav.Providers.Nextcloud\WinDav.Providers.Nextcloud.csproj" />
    <ProjectReference Include="..\WinDav.Providers.WebDav\WinDav.Providers.WebDav.csproj" />
  </ItemGroup>

</Project>
