* text=auto eol=lf

# The exceptions that genuinely need CRLF: cmd.exe mis-parses an LF batch file,
# and Windows PowerShell 5.1 is not reliable either.
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Not a matter of correctness but of the tool that writes the file: dotnet restore writes
# the lock files with CRLF on Windows, and a restore would otherwise leave them looking
# modified until the index is renormalised. What is stored stays LF. See decision 11:
# https://github.com/ernolf/WinDAV/wiki/Decisions#11-lf-in-the-working-tree-on-every-platform
packages.lock.json text eol=crlf

*.png binary
*.ico binary
*.zip binary
*.msi binary
